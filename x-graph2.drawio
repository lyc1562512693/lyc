  <diagram name="3-两套策略组合决策流" id="page3">
    <mxGraphModel dx="1200" dy="900" grid="0" page="1" pageWidth="1200" pageHeight="1200" adaptiveColors="auto">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="ct" value="场景聚合 × 默认兜底聚合 · 组合决策流" style="text;html=1;fontSize=18;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="300" y="20" width="600" height="30" as="geometry" />
        </mxCell>
        <mxCell id="c0" value="研判后待压缩边（含研判结论）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="440" y="70" width="320" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c1" value="生成公共前缀（两套策略一致，回退无桶漂移）&#xa;tenantId : direction : attackResult : ipStrategyKey" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="400" y="150" width="400" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="场景规则匹配？&#xa;threatClass/Type/SubType 查场景聚合表" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="450" y="240" width="300" height="90" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="威胁语义/规则字段可信？&#xa;alertRuleId 可映射、场景实体字段完整" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="160" y="370" width="300" height="90" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="场景聚合：确定基准层级（场景表 L0–L3）&#xa;按攻击结果升降层：失陷/成功升 L0/L1；尝试/失败降 L1/L2&#xa;历史聚合边（非本轮触发）统一降 L2/L3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="120" y="510" width="380" height="90" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="默认兜底聚合&#xa;alertRuleId + 场景实体字段 + 相似度分桶&#xa;（等效 L1/L2 粒度）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="700" y="510" width="380" height="90" as="geometry" />
        </mxCell>
        <mxCell id="c6" value="layerKey 计算&#xa;L0: pktHash（归一化+分桶）· L1: segHash · L2: alertRuleId · L3: ruleId" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="120" y="640" width="380" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c7" value="finalKey = 公共前缀 : layerKey&#xa;命中同 Key 骨架边 → 字段合并；未命中 → 新建压缩边" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="400" y="760" width="400" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c8" value="写回图骨架（Cassandra 按天分块）" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="460" y="870" width="280" height="80" as="geometry" />
        </mxCell>
        <mxCell id="cn1" value="优先级：场景聚合 &gt; 默认兜底&#xa;回退条件：未命中场景表 / 规则缺失 / 语义不可信 / layerKey 派生字段缺失&#xa;硬编码规则兜底防语义不准（S1 问题10）" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="760" y="240" width="380" height="90" as="geometry" />
        </mxCell>
