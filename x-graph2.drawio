        </mxCell>
        <mxCell id="b5d" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" value="其他场景&#xa;账号/命令模板/IOC 等关键实体" vertex="1">
          <mxGeometry height="60" width="220" x="855" y="710" as="geometry" />
