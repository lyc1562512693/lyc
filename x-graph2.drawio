        <mxCell id="b6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" value="相似度处理（归一化 / 分桶，BPE 分词方案）&#xa;URL 相似度（HTTP）· 文件名相似度（病毒文件）· 命令去变量 · 请求体去随机值" vertex="1">
          <mxGeometry height="70" width="440" x="380" y="810" as="geometry" />
        </mxCell>
        <mxCell id="b7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" value="生成最终聚合 Key&#xa;tenantId : direction : attackResult : ipStrategyKey : alertRuleId : entityHash" vertex="1">
