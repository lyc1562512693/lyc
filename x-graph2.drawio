  <diagram name="2-默认兜底聚合Key生成" id="page2">
    <mxGraphModel dx="1200" dy="900" grid="0" page="1" pageWidth="1200" pageHeight="1400" adaptiveColors="auto">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="bt" value="默认兜底聚合 · 聚合 Key 生成流程" style="text;html=1;fontSize=18;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="300" y="20" width="600" height="30" as="geometry" />
        </mxCell>
        <mxCell id="b0" value="开始（研判后待压缩边）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="480" y="70" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="b1" value="拼接租户 ID（tenantId）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="480" y="150" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="b2" value="拼接方向 + 攻击结果&#xa;（direction + attackResult）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="480" y="230" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="b3" value="按【方向 × 攻击结果】匹配 IP 聚合策略（ip-agg 对照表）&#xa;内网主实体 HostNode 不参与有损聚合；外对外失陷禁止有损压缩" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="400" y="320" width="400" height="70" as="geometry" />
        </mxCell>
        <mxCell id="b3a" value="一对一&#xa;srcIp + dstIp + dstPort" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="180" y="420" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="b3b" value="多源收敛（多对一攻击）&#xa;dstIp + dstPort，源集合聚合" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="480" y="420" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="b3c" value="多目的收敛（一对多访问）&#xa;srcIp，目的集合聚合" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="790" y="420" width="230" height="60" as="geometry" />
        </mxCell>
        <mxCell id="b4" value="拼接威胁类型（默认 alertRuleId，抽象威胁类型）&#xa;多 ruleId 时映射 alertRuleId；多 alertRuleId 取最高优先级" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="400" y="520" width="400" height="60" as="geometry" />
        </mxCell>
        <mxCell id="b5" value="按数据场景拼接实体字段" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="480" y="610" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="b5a" value="HTTP&#xa;URL + 状态码 + 请求方法" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="120" y="710" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="b5b" value="DNS&#xa;域名（eTLD+1）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="360" y="710" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="b5c" value="病毒文件&#xa;病毒家族 + 文件名称" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="580" y="710" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="b5d" value="其他场景&#xa;账号/命令模板/IOC 等关键实体" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="800" y="710" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="b6" value="相似度处理（归一化 / 分桶，BPE 分词方案）&#xa;URL 相似度（HTTP）· 文件名相似度（病毒文件）· 命令去变量 · 请求体去随机值" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="380" y="810" width="440" height="70" as="geometry" />
