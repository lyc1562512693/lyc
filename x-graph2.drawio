        <mxCell id="ct" parent="1" style="text;html=1;fontSize=18;fontStyle=1;align=center;" value="场景聚合 × 默认兜底聚合 · 组合决策流" vertex="1">
          <mxGeometry height="30" width="600" x="300" y="20" as="geometry" />
        </mxCell>
        <mxCell id="c0" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" value="研判后待压缩边（含研判结论）" vertex="1">
          <mxGeometry height="50" width="320" x="440" y="70" as="geometry" />
        </mxCell>
        <mxCell id="c1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="生成公共前缀（两套策略一致，回退无桶漂移）&#xa;tenantId : direction : attackResult : ipStrategyKey" vertex="1">
          <mxGeometry height="60" width="400" x="400" y="150" as="geometry" />
        </mxCell>
        <mxCell id="c2" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="场景规则匹配？&#xa;threatClass/Type/SubType 查场景聚合表" vertex="1">
          <mxGeometry height="90" width="300" x="450" y="240" as="geometry" />
        </mxCell>
        <mxCell id="c3" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="威胁语义/规则字段可信？&#xa;alertRuleId 可映射、场景实体字段完整" vertex="1">
          <mxGeometry height="90" width="300" x="160" y="370" as="geometry" />
        </mxCell>
        <mxCell id="c4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" value="场景聚合：确定基准层级（场景表 L0–L3）&#xa;按攻击结果升降层：失陷/成功升 L0/L1；尝试/失败降 L1/L2&#xa;历史聚合边（非本轮触发）统一降 L2/L3" vertex="1">
          <mxGeometry height="90" width="380" x="120" y="510" as="geometry" />
        </mxCell>
        <mxCell id="c5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" value="默认兜底聚合&#xa;alertRuleId + 场景实体字段 + 相似度分桶&#xa;（等效 L1/L2 粒度）" vertex="1">
          <mxGeometry height="90" width="380" x="700" y="510" as="geometry" />
        </mxCell>
        <mxCell id="c6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" value="layerKey 计算&#xa;L0: pktHash（归一化+分桶）· L1: segHash · L2: alertRuleId · L3: ruleId" vertex="1">
          <mxGeometry height="70" width="380" x="120" y="640" as="geometry" />
        </mxCell>
        <mxCell id="c7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" value="finalKey = 公共前缀 : layerKey&#xa;命中同 Key 骨架边 → 字段合并；未命中 → 新建压缩边" vertex="1">
          <mxGeometry height="70" width="400" x="400" y="760" as="geometry" />
        </mxCell>
        <mxCell id="c8" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="写回图骨架（Cassandra 按天分块）" vertex="1">
          <mxGeometry height="80" width="280" x="460" y="870" as="geometry" />
        </mxCell>
        <mxCell id="cn1" parent="1" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;fillColor=#f5f5f5;strokeColor=#666666;" value="优先级：场景聚合 &gt; 默认兜底&#xa;回退条件：未命中场景表 / 规则缺失 / 语义不可信 / layerKey 派生字段缺失&#xa;硬编码规则兜底防语义不准（S1 问题10）" vertex="1">
