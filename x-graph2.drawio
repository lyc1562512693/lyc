<mxfile host="app.diagrams.net" pages="4">
  <diagram name="1-总体方案图" id="page1">
    <mxGraphModel dx="1725" dy="1056" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1200" math="0" shadow="0" adaptiveColors="auto">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t1" parent="1" style="text;html=1;fontSize=18;fontStyle=1;align=center;" value="模型研判后压缩聚合模块 · 总体方案图（送检后聚合进图骨架）" vertex="1">
          <mxGeometry height="30" width="800" x="300" y="20" as="geometry" />
        </mxCell>
        <mxCell id="up1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" value="x关联触发送检&#xa;（锚点边+关联边）" vertex="1">
          <mxGeometry height="60" width="180" x="80" y="80" as="geometry" />
        </mxCell>
        <mxCell id="up2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" value="扩边：锚点资产近7天图骨架&#xa;（档案+历史重要边+历史聚合边）" vertex="1">
          <mxGeometry height="60" width="240" x="300" y="80" as="geometry" />
        </mxCell>
        <mxCell id="cut2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#9673a6;fontColor=#9673a6;" value="送检前二次字段裁剪&#xa;（本期不设计，虚框预留）" vertex="1">
          <mxGeometry height="60" width="200" x="580" y="80" as="geometry" />
        </mxCell>
        <mxCell id="llm" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="模型研判（GPT）&#xa;输出：边研判结论（成功/失败/失陷/误报/未知）&#xa;gpt_attack_state / gpt_attack_type、主机打标、最新触发边威胁语义刷新" vertex="1">
          <mxGeometry height="80" width="420" x="820" y="70" as="geometry" />
        </mxCell>
        <mxCell id="s1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="① 研判结论更新（先更新结论，再聚合）&#xa;更新送检边/关联边 gpt_attack_state、gpt_attack_type&#xa;仅刷新当前触发边的威胁语义" vertex="1">
          <mxGeometry height="70" width="360" x="520" y="190" as="geometry" />
        </mxCell>
        <mxCell id="s2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="② 重要边调整&#xa;支持本次结论的边 → 打重要边标记&#xa;结论与上次不同 → 取消支持上次结论边的重要边标记&#xa;更新档案（当前及关联资产研判结论）" vertex="1">
          <mxGeometry height="80" width="360" x="520" y="290" as="geometry" />
        </mxCell>
        <mxCell id="retrig" parent="1" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#9673a6;fontColor=#9673a6;" value="研判结论变更重触发送检&#xa;（触发条件/防环/频控，与送检遏制协同）&#xa;第一版仅保留设计，虚框预留" vertex="1">
          <mxGeometry height="80" width="280" x="960" y="290" as="geometry" />
        </mxCell>
        <mxCell id="s3" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="③ 压缩策略路由&#xa;公共前缀：tenantId : direction : attackResult : ipStrategyKey" vertex="1">
          <mxGeometry height="90" width="400" x="500" y="400" as="geometry" />
        </mxCell>
        <mxCell id="s4a" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" value="场景聚合（L0–L3 分层）&#xa;查场景表：threatClass/Type/SubType&#xa;按攻击结果升降层，历史聚合边降 L2/L3" vertex="1">
          <mxGeometry height="80" width="280" x="300" y="530" as="geometry" />
        </mxCell>
        <mxCell id="s4b" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" value="默认兜底聚合&#xa;alertRuleId + 场景实体字段&#xa;+ 相似度归一化/分桶（BPE）" vertex="1">
          <mxGeometry height="80" width="280" x="820" y="530" as="geometry" />
        </mxCell>
        <mxCell id="s5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="④ 聚合 Key 归并（finalKey = 公共前缀 : layerKey）&#xa;⑤ 字段合并（覆盖/集合上限100/首末时间/最高优先级/累加）&#xa;⑥ 数据包字段清理（保留/派生/剥离；原文仅本轮触发边一份）" vertex="1">
          <mxGeometry height="90" width="440" x="480" y="650" as="geometry" />
        </mxCell>
        <mxCell id="cass" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="⑦ 写回图骨架（Cassandra，按天分块）&#xa;graph_skeleton_edge_by_day / 档案 / 子事件" vertex="1">
          <mxGeometry height="100" width="320" x="540" y="780" as="geometry" />
        </mxCell>
        <mxCell id="s7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" value="⑧ 骨架淘汰&#xa;时间（天块TTL 30天）/ 容量（边数·集合上限）/ 层级降级（L0/L1→L2/L3）&#xa;重要边与失陷/成功边最后淘汰" vertex="1">
          <mxGeometry height="80" width="440" x="480" y="920" as="geometry" />
        </mxCell>
        <mxCell id="next" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" value="下一次送检读取：档案 + 历史重要边 + 历史聚合边&#xa;（重要性+最近时间取 Top100 边，辅助 GPT 研判）" vertex="1">
          <mxGeometry height="60" width="320" x="80" y="800" as="geometry" />
        </mxCell>
        <mxCell id="e1" edge="1" parent="1" source="up1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" target="up2">
