  <diagram name="4-骨架淘汰与重要边闭环" id="page4">
    <mxGraphModel dx="1200" dy="900" grid="0" page="1" pageWidth="1300" pageHeight="1000" adaptiveColors="auto">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="dt" value="图骨架淘汰机制（时间 / 容量 / 层级降级）与重要边闭环" style="text;html=1;fontSize=18;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="250" y="20" width="800" height="30" as="geometry" />
        </mxCell>
        <mxCell id="d0" value="图骨架（按天分块，每资产每天一块）&#xa;D-0 ... D-6 参与送检（回看7天）；D-7 ... D-29 仅存储；D-30+ 过期" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="350" y="70" width="600" height="70" as="geometry" />
        </mxCell>
        <mxCell id="d1" value="① 时间淘汰&#xa;天块整体过期（Cassandra TTL=30天）&#xa;边级动态 ttl（重要资产 ×2）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="120" y="200" width="300" height="90" as="geometry" />
        </mxCell>
        <mxCell id="d2" value="② 容量淘汰&#xa;单边聚合 IP 集合上限 100（srcIp/dstIp）&#xa;单资产骨架边数超限 → 按优先级裁剪&#xa;重要边 &gt; 失陷/成功边 &gt; 高危边 &gt; 近期边 &gt; 其他" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="490" y="200" width="330" height="90" as="geometry" />
        </mxCell>
        <mxCell id="d3" value="③ 层级降级淘汰&#xa;老化边先降层收缩体积：L0/L1 → L2/L3&#xa;剥离包字段原文，仅留威胁语义+统计+实体&#xa;再按时间/容量淘汰，避免一刀切丢语义" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="890" y="200" width="320" height="90" as="geometry" />
        </mxCell>
        <mxCell id="d4" value="读取侧（送检组图）&#xa;按【重要边标记 &gt; 攻击结果优先级 &gt; lastTimestamp】排序取 Top100 边&#xa;（甜区 ≤100 条边，极限 400）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="400" y="340" width="500" height="80" as="geometry" />
        </mxCell>
        <mxCell id="d5" value="重要边闭环&#xa;GPT 结论更新 → 支持本次结论的边保留/新增重要边标记&#xa;结论翻转 → 取消支持上次结论边的标记，回归历史聚合边池按普通策略淘汰&#xa;窗口内支撑当前结论的重要边不淘汰" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="330" y="470" width="640" height="100" as="geometry" />
        </mxCell>
        <mxCell id="d6" value="研判结论变更重触发（第一版预留）&#xa;升级必触发（误报→失陷）；降级仅更新档案&#xa;防环：同结论遏制窗口内不重触发；频控：次数上限+冷却时间" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#9673a6;fontColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="400" y="620" width="500" height="90" as="geometry" />
        </mxCell>
        <mxCell id="de1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="d0" target="d1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="de2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="d0" target="d2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="de3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="d0" target="d3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="de4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="d2" target="d4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="de5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="d4" target="d5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
