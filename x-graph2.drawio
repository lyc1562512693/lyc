  <diagram name="3-两套策略组合决策流" id="page3">
    <mxGraphModel dx="1265" dy="775" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1200" math="0" shadow="0" adaptiveColors="auto">
      <root>
