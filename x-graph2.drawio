  <diagram name="2-默认兜底聚合Key生成" id="page2">
    <mxGraphModel dx="1582" dy="968" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1400" math="0" shadow="0" adaptiveColors="auto">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="bt" parent="1" style="text;html=1;fontSize=18;fontStyle=1;align=center;" value="默认兜底聚合 · 聚合 Key 生成流程" vertex="1">
          <mxGeometry height="30" width="600" x="300" y="20" as="geometry" />
        </mxCell>
        <mxCell id="b0" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" value="开始（研判后待压缩边）" vertex="1">
          <mxGeometry height="50" width="240" x="480" y="70" as="geometry" />
        </mxCell>
        <mxCell id="b1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="拼接租户 ID（tenantId）" vertex="1">
          <mxGeometry height="50" width="240" x="480" y="150" as="geometry" />
        </mxCell>
        <mxCell id="b2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="拼接方向 + 攻击结果&#xa;（direction + attackResult）" vertex="1">
          <mxGeometry height="60" width="240" x="480" y="230" as="geometry" />
        </mxCell>
        <mxCell id="b3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="按【方向 × 攻击结果】匹配 IP 聚合策略（ip-agg 对照表）&#xa;内网主实体 HostNode 不参与有损聚合；外对外失陷禁止有损压缩" vertex="1">
          <mxGeometry height="70" width="400" x="400" y="320" as="geometry" />
        </mxCell>
        <mxCell id="b3a" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" value="一对一&#xa;srcIp + dstIp + dstPort" vertex="1">
          <mxGeometry height="60" width="220" x="180" y="420" as="geometry" />
        </mxCell>
        <mxCell id="b3b" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" value="多源收敛（多对一攻击）&#xa;dstIp + dstPort，源集合聚合" vertex="1">
          <mxGeometry height="60" width="240" x="480" y="420" as="geometry" />
        </mxCell>
        <mxCell id="b3c" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" value="多目的收敛（一对多访问）&#xa;srcIp，目的集合聚合" vertex="1">
          <mxGeometry height="60" width="230" x="790" y="420" as="geometry" />
        </mxCell>
        <mxCell id="b4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="拼接威胁类型（默认 alertRuleId，抽象威胁类型）&#xa;多 ruleId 时映射 alertRuleId；多 alertRuleId 取最高优先级" vertex="1">
          <mxGeometry height="60" width="400" x="400" y="520" as="geometry" />
        </mxCell>
        <mxCell id="b5" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="按数据场景拼接实体字段" vertex="1">
          <mxGeometry height="70" width="240" x="480" y="610" as="geometry" />
        </mxCell>
        <mxCell id="b5a" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" value="HTTP&#xa;URL + 状态码 + 请求方法" vertex="1">
          <mxGeometry height="60" width="200" x="120" y="710" as="geometry" />
        </mxCell>
        <mxCell id="b5b" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" value="DNS&#xa;域名（eTLD+1）" vertex="1">
          <mxGeometry height="60" width="180" x="360" y="710" as="geometry" />
        </mxCell>
        <mxCell id="b5c" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" value="病毒文件&#xa;病毒家族 + 文件名称" vertex="1">
