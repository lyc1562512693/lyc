        <mxCell id="b7" value="生成最终聚合 Key&#xa;tenantId : direction : attackResult : ipStrategyKey : alertRuleId : entityHash" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="380" y="910" width="440" height="70" as="geometry" />
