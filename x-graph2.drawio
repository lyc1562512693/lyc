  <diagram name="4-骨架淘汰与重要边闭环" id="page4">
    <mxGraphModel dx="1186" dy="726" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="1000" math="0" shadow="0" adaptiveColors="auto">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="dt" parent="1" style="text;html=1;fontSize=18;fontStyle=1;align=center;" value="图骨架淘汰机制（时间 / 容量 / 层级降级）与重要边闭环" vertex="1">
          <mxGeometry height="30" width="800" x="250" y="20" as="geometry" />
        </mxCell>
        <mxCell id="d0" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="图骨架（按天分块，每资产每天一块）&#xa;D-0 ... D-6 参与送检（回看7天）；D-7 ... D-29 仅存储；D-30+ 过期" vertex="1">
          <mxGeometry height="70" width="600" x="350" y="70" as="geometry" />
        </mxCell>
        <mxCell id="d1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" value="① 时间淘汰&#xa;天块整体过期（Cassandra TTL=30天）&#xa;边级动态 ttl（重要资产 ×2）" vertex="1">
          <mxGeometry height="90" width="300" x="120" y="200" as="geometry" />
        </mxCell>
        <mxCell id="d2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" value="② 容量淘汰&#xa;单边聚合 IP 集合上限 100（srcIp/dstIp）&#xa;单资产骨架边数超限 → 按优先级裁剪&#xa;重要边 &gt; 失陷/成功边 &gt; 高危边 &gt; 近期边 &gt; 其他" vertex="1">
          <mxGeometry height="90" width="330" x="485" y="203" as="geometry" />
        </mxCell>
        <mxCell id="d3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" value="③ 层级降级淘汰&#xa;老化边先降层收缩体积：L0/L1 → L2/L3&#xa;剥离包字段原文，仅留威胁语义+统计+实体&#xa;再按时间/容量淘汰，避免一刀切丢语义" vertex="1">
          <mxGeometry height="90" width="320" x="890" y="200" as="geometry" />
        </mxCell>
        <mxCell id="d4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="读取侧（送检组图）&#xa;按【重要边标记 &gt; 攻击结果优先级 &gt; lastTimestamp】排序取 Top100 边&#xa;（甜区 ≤100 条边，极限 400）" vertex="1">
          <mxGeometry height="80" width="500" x="400" y="340" as="geometry" />
        </mxCell>
        <mxCell id="d5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" value="重要边闭环&#xa;GPT 结论更新 → 支持本次结论的边保留/新增重要边标记&#xa;结论翻转 → 取消支持上次结论边的标记，回归历史聚合边池按普通策略淘汰&#xa;窗口内支撑当前结论的重要边不淘汰" vertex="1">
          <mxGeometry height="100" width="640" x="330" y="470" as="geometry" />
        </mxCell>
        <mxCell id="d6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#9673a6;fontColor=#9673a6;" value="研判结论变更重触发（第一版预留）&#xa;升级必触发（误报→失陷）；降级仅更新档案&#xa;防环：同结论遏制窗口内不重触发；频控：次数上限+冷却时间" vertex="1">
          <mxGeometry height="90" width="500" x="400" y="620" as="geometry" />
        </mxCell>
        <mxCell id="de1" edge="1" parent="1" source="d0" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" target="d1">
          <mxGeometry relative="1" as="geometry" />
